# ─── Node.js ───────────────────────────────────────────────────────────────────
# Never commit the node_modules folder.
# It can be 200MB+ and is always regenerated by running: npm install
node_modules/

# ─── Next.js ───────────────────────────────────────────────────────────────────
# Build output — generated automatically by: npm run build
.next/
out/

# ─── Environment Variables ─────────────────────────────────────────────────────
# CRITICAL: .env.local contains your secret Firebase keys, JWT secrets,
# and database passwords. NEVER upload this file to GitHub.
# Use .env.example as the safe template (no real values).
.env.local
.env.production
.env.*.local
.env

# ─── User Uploads (Server/Paid Mode) ──────────────────────────────────────────
# In server mode, uploaded images are saved here.
# These are large, server-specific files — not part of the codebase.
public/uploads/

# ─── Prisma Generated Client ───────────────────────────────────────────────────
prisma/generated/

# ─── PM2 Logs ──────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS Files ──────────────────────────────────────────────────────────────────
# Mac OS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# ─── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─── Firebase ──────────────────────────────────────────────────────────────────
# Service account key files — these contain admin credentials.
# NEVER commit these to GitHub.
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
.firebase/

# ─── Testing ───────────────────────────────────────────────────────────────────
coverage/

# ─── Misc ──────────────────────────────────────────────────────────────────────
*.tgz
.yarn-integrity