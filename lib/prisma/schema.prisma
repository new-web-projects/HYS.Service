// ================================================================
// HYS Services — Production Schema (Part 1 draft: Postgres + Prisma
// + Better Auth target architecture)
//
// STATUS: Design artifact, not yet run against a real database.
// I have no live Postgres connection from this environment, so this
// has been reviewed carefully but not migrated or query-tested.
// Before running `prisma migrate dev`:
//   1. Run Better Auth's own generator (`npx @better-auth/cli
//      generate`) against this file once Better Auth is configured
//      in your project — it will add/correct any fields specific to
//      your installed version and whichever plugins you enable
//      (social login, 2FA, etc.). The User/Session/Account/
//      Verification models below follow Better Auth's current
//      documented Prisma convention, but their generator is the
//      authoritative source, not this file.
//   2. Review every model against your actual current data before
//      migrating real records — this schema is designed from the
//      Firestore data model as I understand it from the booking/
//      chat/payment work done earlier in this project, not from a
//      live export of your data.
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================================================================
// BETTER AUTH CORE
// ================================================================

enum UserRole {
  customer
  worker
  admin
  superadmin
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?   @unique
  role          UserRole  @default(customer)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?

  bookingsAsCustomer Booking[]       @relation("BookingCustomer")
  bookingsAsWorker   Booking[]       @relation("BookingWorker")
  jobRequests        JobRequest[]
  quotes             Quote[]
  reviewsWritten     Review[]        @relation("ReviewAuthor")
  reviewsReceived    Review[]        @relation("ReviewWorker")
  notifications      Notification[]
  earnings           WorkerEarning[]
  withdrawals        Withdrawal[]
  supportTicketsAsCustomer SupportTicket[] @relation("TicketCustomer")
  supportTicketsAsWorker   SupportTicket[] @relation("TicketWorker")
  ticketReplies      TicketReply[]
  chatParticipants   ChatParticipant[]
  messagesSent       Message[]
  auditLogs          AuditLog[]
  errorReportsFiled  ErrorReport[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@map("verification")
}

// ================================================================
// LEGACY ADMIN (JWT-based) — retained only so the existing admin
// login keeps working during migration. Plan to remove once Part 3
// (Better Auth) actually replaces it — see note above.
// ================================================================

enum LegacyAdminRole {
  editor
  superadmin
}

model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         LegacyAdminRole @default(editor)
  createdAt    DateTime   @default(now())
  lastLogin    DateTime?
  auditLogs    AuditLog[] @relation("LegacyAdminAuditLogs")
}

// ================================================================
// ROLE-SPECIFIC PROFILES
// ================================================================

model CustomerProfile {
  userId    String   @id
  address   String?  @db.Text
  latitude  Float?
  longitude Float?
  city      String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profile")
}

enum WorkerVerificationStatus {
  pending
  verified
  rejected
}

model WorkerProfile {
  userId             String   @id
  categoryId         String?
  bio                String?  @db.Text
  experienceYears    Int      @default(0)
  isAvailable        Boolean  @default(true)
  verificationStatus WorkerVerificationStatus @default(pending)
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  latitude           Float?
  longitude          Float?
  city               String?
  serviceRadiusKm    Float?
  panDocUrl          String?
  aadhaarDocUrl      String?
  workIdDocUrl       String?
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([verificationStatus])
  @@map("worker_profile")
}

// ================================================================
// CATEGORIES
// ================================================================

enum CategoryStatus {
  pending
  active
  rejected
}

model Category {
  id           String         @id @default(cuid())
  name         String
  description  String?        @db.Text
  icon         String?
  status       CategoryStatus @default(pending)
  submittedBy  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workers WorkerProfile[]

  @@index([status])
}

// ================================================================
// BOOKINGS, JOB REQUESTS, QUOTES
// ================================================================

enum BookingStatus {
  pending_chat
  discussing
  final_price_pending
  ready_for_payment
  paid
  completed
  cancelled_before_payment
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum OtpStatus {
  pending
  verified
  locked
  dispute
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  workerId    String
  categoryId  String?
  description String?       @db.Text
  address     String?       @db.Text
  scheduledAt DateTime?
  notes       String?       @db.Text

  status        BookingStatus @default(pending_chat)
  paymentStatus PaymentStatus @default(unpaid)

  // Pricing — confirmedPrice is the single source of truth once set;
  // basePrice/platformFee/gstAmount are the computed breakdown at the
  // time of confirmation (see the earlier confirmFinalPrice fix this
  // schema is designed to preserve the intent of).
  confirmedPrice Float?
  basePrice      Float   @default(0)
  platformFee    Float   @default(0)
  gstAmount      Float   @default(0)
  priceQuoted    Float   @default(0)

  // Revealed only after payment
  workerPhone   String?
  customerPhone String?

  // OTP-based completion
  completionOtp String?
  otpVerified   Boolean   @default(false)
  otpStatus     OtpStatus @default(pending)
  otpAttempts   Int       @default(0)

  // Payment linkage — generalized for multi-gateway (Part 9), not
  // Razorpay-specific
  paymentGateway       String? // "razorpay" | "phonepe" | "paytm"
  paymentRef           String? // gateway payment id
  transactionId        String? // FK-able to Transaction.id once paid
  pendingOrderId        String?
  pendingOrderAmount    Int?
  pendingOrderCreatedAt DateTime?

  jobRequestId String?
  quoteId      String?
  cancelledBy  String?
  completedAt  DateTime?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer User @relation("BookingCustomer", fields: [customerId], references: [id])
  worker   User @relation("BookingWorker", fields: [workerId], references: [id])

  chat         Chat?
  review       Review?
  earning      WorkerEarning?
  transactions Transaction[]
  paymentLogs  PaymentLog[]

  @@index([customerId])
  @@index([workerId])
  @@index([status])
  @@index([paymentStatus])
}

enum JobRequestStatus {
  open
  closed
  expired
}

model JobRequest {
  id          String           @id @default(cuid())
  customerId  String
  categoryId  String?
  description String?          @db.Text
  address     String?          @db.Text
  budget      Float?
  status      JobRequestStatus @default(open)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer User     @relation(fields: [customerId], references: [id])
  quotes   Quote[]

  @@index([customerId])
  @@index([status])
}

enum QuoteStatus {
  pending
  accepted
  declined
}

model Quote {
  id           String      @id @default(cuid())
  jobRequestId String
  workerId     String
  basePrice    Float
  platformFee  Float
  gstAmount    Float
  finalPrice   Float
  message      String?     @db.Text
  status       QuoteStatus @default(pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id])
  worker     User       @relation(fields: [workerId], references: [id])

  @@index([jobRequestId])
  @@index([workerId])
}

// ================================================================
// CHAT
// ================================================================

enum ChatStatus {
  active
  price_proposed
  price_confirmed
  booked
  closed
}

model Chat {
  id         String     @id @default(cuid())
  bookingId  String     @unique
  status     ChatStatus @default(active)

  bookingAccepted   Boolean  @default(false)
  bookingRejected   Boolean  @default(false)
  customerConfirmed Boolean  @default(false)
  workerConfirmed   Boolean  @default(false)
  readyForPayment   Boolean  @default(false)
  confirmedPrice    Float?

  lastMessage   String?  @db.Text
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking      Booking           @relation(fields: [bookingId], references: [id])
  messages     Message[]
  participants ChatParticipant[]

  @@index([status])
}

model ChatParticipant {
  chatId       String
  userId       String
  unreadCount  Int      @default(0)
  lastReadAt   DateTime?

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([chatId, userId])
}

enum MessageType {
  text
  system
  price_proposal
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  senderId  String?     // null for system messages
  type      MessageType @default(text)
  text      String      @db.Text
  createdAt DateTime    @default(now())

  chat   Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id])

  @@index([chatId, createdAt])
}

// ================================================================
// REVIEWS
// ================================================================

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  authorId  String
  workerId  String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  worker  User    @relation("ReviewWorker", fields: [workerId], references: [id])

  @@index([workerId])
}

// ================================================================
// NOTIFICATIONS
// ================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // booking_paid, booking_accepted, etc.
  title     String
  body      String?  @db.Text
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

// ================================================================
// PAYMENTS — MULTI-GATEWAY (Part 9)
// ================================================================

enum PaymentGateway {
  razorpay
  phonepe
  paytm
}

enum PaymentMode {
  test
  live
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

model Transaction {
  id            String             @id @default(cuid())
  bookingId     String
  gateway       PaymentGateway
  mode          PaymentMode
  orderId       String
  paymentId     String?
  customerId    String
  workerId      String
  amount        Float              // total charged to customer
  workerAmount  Float              // what worker earns
  platformFee   Float
  gstAmount     Float
  status        TransactionStatus  @default(pending)
  refundStatus  String?
  createdAt     DateTime           @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([gateway])
  @@index([status])
  @@index([customerId])
  @@index([workerId])
}

// Diagnostic trail per payment attempt (Part 6 of the earlier bug-fix
// work) — kept and generalized across gateways.
model PaymentLog {
  id                 String   @id @default(cuid())
  bookingId          String
  gateway            PaymentGateway
  orderId            String
  paymentId          String?
  workerId           String?
  customerId         String?
  finalPrice         Float?
  platformFee        Float?
  gstAmount          Float?
  totalAmount        Float?
  paymentStatus      String?
  verificationStatus String?
  errorMessage       String?  @db.Text
  timestamp          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([orderId])
  @@index([bookingId])
}

model WorkerEarning {
  id          String   @id @default(cuid())
  workerId    String
  bookingId   String   @unique
  customerId  String
  baseAmount  Float
  platformFee Float
  gstAmount   Float
  totalPaid   Float
  status      String   @default("locked") // locked | available | pending_withdrawal | withdrawn
  paidAt      DateTime?
  unlockedAt  DateTime?
  createdAt   DateTime @default(now())

  worker  User    @relation(fields: [workerId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([workerId, status])
}

enum WithdrawalStatus {
  pending
  completed
  rejected
}

model Withdrawal {
  id        String           @id @default(cuid())
  workerId  String
  amount    Float
  status    WithdrawalStatus @default(pending)
  method    String?
  reason    String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@index([workerId, status])
}

// ================================================================
// SUPPORT TICKETS (Part 10 — future-ready)
// ================================================================

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

model SupportTicket {
  id          String         @id @default(cuid())
  ticketNo    String         @unique // HYS-000001, sequential — see note
  customerId  String?
  workerId    String?
  subject     String
  issue       String         @db.Text
  priority    TicketPriority @default(medium)
  status      TicketStatus   @default(open)
  attachments Json           @default("[]")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  customer User?         @relation("TicketCustomer", fields: [customerId], references: [id])
  worker   User?         @relation("TicketWorker", fields: [workerId], references: [id])
  replies  TicketReply[]

  @@index([status])
  @@index([customerId])
  @@index([workerId])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  message   String   @db.Text
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ================================================================
// CMS / ADMIN (existing — carried over as-is from the current schema)
// ================================================================

model Page {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  metaDescription String?   @db.Text
  sectionsJson    Json      @default("[]")
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model Media {
  id        String   @id @default(uuid())
  url       String   @db.Text
  publicId  String?
  provider  String   @default("cloudinary") // "cloudinary" | "s3" — Part 4
  filename  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
}

// ================================================================
// PLATFORM SETTINGS — extended for Part 1's admin-configurable
// storage provider + multi-gateway payment toggles + feature toggles
// ================================================================

model Settings {
  id              Int      @id @default(1)
  siteName        String   @default("HYS Services")
  logoUrl         String?  @db.Text
  primaryColor    String   @default("#3B82F6")
  socialLinksJson Json     @default("{}")
  contactEmail    String?
  footerText      String?  @db.Text

  // Storage provider toggle (Part 4)
  storageProvider String  @default("cloudinary") // "cloudinary" | "s3"

  // Payment gateway toggles + mode (Part 1 / Part 9)
  razorpayEnabled Boolean     @default(true)
  phonepeEnabled  Boolean     @default(false)
  paytmEnabled    Boolean     @default(false)
  paymentMode     PaymentMode @default(test)

  platformFeePercent Float   @default(10)
  platformFeeType    String  @default("percent")
  platformFixed      Float   @default(0)
  gstPercent         Float   @default(18)
  gstModeEnabled     Boolean @default(false)
  withdrawalFee      Float   @default(11)

  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("We are performing scheduled maintenance. Please check back soon.") @db.Text
  estimatedReturn    String  @default("")

  errorRevealEnabled Boolean @default(true) // Part 11 toggle

  // Feature toggles (Part 7) — extend freely without a migration
  featureToggles Json @default("{}")

  updatedAt DateTime @updatedAt
}

// ================================================================
// LOGGING / AUDIT
// ================================================================

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String?
  legacyAdminId String?
  action       String
  collection   String
  documentId   String
  beforeJson   Json?
  afterJson    Json?
  createdAt    DateTime @default(now())

  admin       User?  @relation(fields: [adminId], references: [id])
  legacyAdmin Admin? @relation("LegacyAdminAuditLogs", fields: [legacyAdminId], references: [id])

  @@index([collection, documentId])
}

model ErrorLog {
  id            String   @id @default(uuid())
  message       String   @db.Text
  stackTrace    String?  @db.Text
  fileName      String?
  componentName String?
  functionName  String?
  apiRoute      String?
  source        String?  // "nextjs" | "prisma" | "socket" | "redis" | "razorpay" | "phonepe" | "paytm" | "auth"
  browserInfo   String?  @db.Text
  deviceInfo    String?  @db.Text
  userRole      String?
  createdAt     DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}

model ErrorReport {
  id          String   @id @default(uuid())
  userId      String?
  message     String   @db.Text
  stackTrace  String?  @db.Text
  fileName    String?
  route       String?
  browserInfo String?  @db.Text
  deviceInfo  String?  @db.Text
  userRole    String?
  status      String   @default("open")
  notes       String   @default("") @db.Text
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
}
