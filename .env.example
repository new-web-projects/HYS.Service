# HYS Services — Version 2
# Copy to .env.local for local development. Never commit a file with real
# values — only .env.example (this file) is meant to be in git.
#
# Variables are grouped by the Part that introduces them. Most are commented
# out until that Part exists, so an empty/default setup still boots cleanly
# today. Uncomment and fill in as each Part is built.

# ── App (Part 2 — active now) ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database — PostgreSQL + Prisma (Part 3 — active now) ───────────────────
# The values below match docker-compose.yml, so `docker compose up -d` +
# these two lines is enough for local dev / Codespaces out of the box.
# In production, DATABASE_URL should be a *pooled* connection string
# (PgBouncer or your provider's pooler — required for Vercel's serverless
# connection limits); DIRECT_URL is the non-pooled one Prisma Migrate needs.
DATABASE_URL="postgresql://hys:hys_dev_password@localhost:5432/hys_services"
DIRECT_URL="postgresql://hys:hys_dev_password@localhost:5432/hys_services"

# ── Redis (Part 3 — active now) ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Authentication — Better Auth (Part 4 — active now) ─────────────────────
BETTER_AUTH_SECRET=                # openssl rand -base64 32 — required, 32+ chars
BETTER_AUTH_URL=http://localhost:3000

# One-time seed for the first Super Admin (there's no public admin signup —
# see prisma/seed.ts). Remove or rotate the password after first login.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Super Admin

# ── Payments — Razorpay, PhonePe, Paytm (Part 8) ───────────────────────────
# Enable/disable and TEST-vs-LIVE mode are admin/DB-configurable
# (Settings.razorpayEnabled etc., Settings.paymentMode) — these env vars
# only ever hold the credential values themselves, never a mode flag, so
# switching modes never needs a redeploy. Fill in whichever gateways you
# actually enable; an unset credential for a gateway that's off is fine.

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PhonePe — OAuth client credentials from the PhonePe Business Dashboard
PHONEPE_TEST_CLIENT_ID=
PHONEPE_TEST_CLIENT_SECRET=
PHONEPE_TEST_CLIENT_VERSION=1
PHONEPE_LIVE_CLIENT_ID=
PHONEPE_LIVE_CLIENT_SECRET=
PHONEPE_LIVE_CLIENT_VERSION=1
# Base URLs — sandbox values below are confirmed directly against
# PhonePe's own current API reference. The LIVE values follow the same
# documented naming pattern but weren't reachable as an exact quoted
# string during development — double-check both against the PhonePe
# Business Dashboard before going live (see MANUAL-VERIFICATION.md).
# PHONEPE_TEST_AUTH_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/v1/oauth/token
# PHONEPE_TEST_API_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
# PHONEPE_LIVE_AUTH_URL=https://api.phonepe.com/apis/identity-manager/v1/oauth/token
# PHONEPE_LIVE_API_BASE_URL=https://api.phonepe.com/apis/pg
# Webhook auth: PhonePe calls back with Basic-auth-style credentials you
# configure on their dashboard, not a request you initiate — set the same
# username/password here that you configured there.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Paytm — from the Paytm Business Dashboard
PAYTM_TEST_MERCHANT_ID=
PAYTM_TEST_MERCHANT_KEY=
PAYTM_TEST_WEBSITE=WEBSTAGING
PAYTM_LIVE_MERCHANT_ID=
PAYTM_LIVE_MERCHANT_KEY=
PAYTM_LIVE_WEBSITE=DEFAULT
# Base URL — staging value below is confirmed against Paytm's own docs;
# the production equivalent follows their documented naming convention
# but wasn't reachable as an exact quoted string during development —
# double-check against the Paytm Business Dashboard before going live
# (see MANUAL-VERIFICATION.md).
# PAYTM_TEST_BASE_URL=https://securestage.paytmpayments.com
# PAYTM_LIVE_BASE_URL=https://securegw.paytmpayments.com
# ── Real-time — Socket.IO (Part 7 — active now) ────────────────────────────
# Path Socket.IO's own transport listens on. NEXT_PUBLIC_ (not a plain
# server-only var) is deliberate: the browser client has to request this
# exact same path, and only NEXT_PUBLIC_-prefixed vars reach client-side
# code — a plain SOCKET_IO_PATH here would silently stay server-only and
# the client would fall back to a hardcoded default that could drift out
# of sync with it. server.ts is the actual entrypoint (`npm run dev`/
# `start` both use it instead of `next dev`/`next start`) — it attaches
# Socket.IO to the same HTTP server Next.js uses, so one process serves
# both. PORT follows the platform's convention (Codespaces/most VPS+PM2
# setups inject it); 3000 is the fallback for local dev.
NEXT_PUBLIC_SOCKET_IO_PATH=/api/socket
PORT=3000
# Same-origin by default (client infers it from window.location). Only set
# this if the Socket.IO transport is ever split onto a different origin
# than the Next.js app itself — see server.ts's file-header comment for
# when that applies (Vercel).
# NEXT_PUBLIC_SOCKET_URL=

# ── Storage — Cloudinary + Amazon S3 (Part 11) ─────────────────────────────
# Active provider is chosen in the Admin Panel, not here — both credential
# sets can be configured at once so an admin can switch without a redeploy.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ── Email — SMTP / transactional provider (Part 4, extended in Part 7) ────
# Without this, lib/email.ts logs emails to the console instead of sending
# them — enough to click a verification/reset link, or see a booking
# notification, by hand while testing. Uncomment once you've picked a
# provider.
# EMAIL_FROM="HYS Services <no-reply@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
