# ─────────────────────────────────────────────
# BACKEND MODE SELECTOR
# ─────────────────────────────────────────────
# Controls which adapter the app uses.
# Set to "firebase" for free hosting (Firestore + Cloudinary).
# Set to "server" for paid hosting (MySQL + local file storage).
NEXT_PUBLIC_BACKEND_MODE=firebase

# ─────────────────────────────────────────────
# FIREBASE (free mode)
# ─────────────────────────────────────────────
# All values from: Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side only — never expose to client)
# Value: JSON string of your service account key object
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────
# CLOUDINARY (free mode — media uploads only)
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=headlinex
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=HeadlineX
NEXT_PUBLIC_CLOUDINARY_FOLDER=site-images
NEXT_PUBLIC_CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/headlinex/image/upload

# Cloudinary API credentials (server-side only — for media deletion)
# Generate at: https://console.cloudinary.com/settings/api-keys
# Optional — if unset, deleting a media item removes the DB record but leaves the Cloudinary file.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay (Option A — Recommended) ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_PAYMENT_ENABLED=true

# ─────────────────────────────────────────────
# MYSQL / PRISMA (paid mode)
# ─────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ─────────────────────────────────────────────
# JWT (paid mode)
# ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000